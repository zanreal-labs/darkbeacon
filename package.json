{
  "name": "darkbeacon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @darkbeacon/web build",
    "typecheck": "tsc -b && pnpm --filter @darkbeacon/web typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:pg": "TEST_DIALECTS=postgres vitest run",
    "test:watch": "vitest",
    "dev": "tsc -b && concurrently -k -n server,web -c blue,magenta \"pnpm --filter @darkbeacon/server dev\" \"pnpm --filter @darkbeacon/web dev\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
