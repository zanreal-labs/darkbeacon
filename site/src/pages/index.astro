---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import Logo from '../components/Logo.astro';
import { arrow, github, server } from '../components/icons';
import Shot from '../components/Shot.astro';
import Stage from '../components/Stage.astro';
import AgentAvatars from '../components/AgentAvatars.astro';
import { APP_URL, COMPANY_URL, ISSUES_URL, REPO_URL, SELF_HOST_URL, SITE_URL } from '../config';
import { compose, install } from '../data/snippets';

const title = 'Darkbeacon · the live wormhole mapper for EVE Online';
const description =
  'A live chain map your whole corp edits at once: signatures in the game’s scan colours, routes to the trade hubs, kill intel, a capital jump planner and an import from Wanderer. Self-hosted in one Docker container.';

// Structured data: the app itself, published by the company that makes it.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Darkbeacon',
  description,
  url: SITE_URL,
  applicationCategory: 'GameApplication',
  operatingSystem: 'Web, Docker',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  sameAs: [REPO_URL],
  publisher: { '@type': 'Organization', name: 'ZanReal', url: COMPANY_URL },
};

const steps = [
  { id: 'scan', n: '01', name: 'Scan' },
  { id: 'map', n: '02', name: 'Map' },
  { id: 'fight', n: '03', name: 'Fight' },
  { id: 'capitals', n: '04', name: 'Move capitals' },
  { id: 'alliance', n: '05', name: 'Alliance' },
];

// The systems of the demo chain the map scene draws (apps/server/src/modules/demo/demo-chain.ts),
// labelled by the scene as it assembles.
const chainNodes = [
  { name: 'J014348', meta: 'C3 · Home' },
  { name: 'J130256', meta: 'C2 · Magnetar' },
  { name: 'Pulsar C5', meta: 'C5 · Hostile' },
  { name: 'EC-P8R', meta: 'Null-sec' },
  { name: 'Nourvukaiken', meta: 'High-sec · WH1' },
  { name: 'Tama', meta: 'Low-sec' },
  { name: 'Amamake', meta: 'Low-sec · WH2' },
  { name: 'J121158', meta: 'C1 · Black Hole' },
];

// Each section of the homepage: a headline, one sentence, a few short items, one picture. The
// details (and every spec that used to be here) are on /features and /wanderer.
type Item = [title: string, text: string];

const scanItems: Item[] = [
  ['Scan colours', 'As the client draws them, from red under 25 % to green when you can warp.'],
  ['Wormholes', 'Identified holes in their own blue-violet, with a bar on the row.'],
  ['Wormhole types', 'All 102, K162 included. Press <kbd>W</kbd>, or click any type code on the map.'],
];

const mapItems: Item[] = [
  ['Automapping', 'A jump adds the system and the connection, browser open or not.'],
  ['Undo', '<kbd>Ctrl</kbd>+<kbd>Z</kbd> takes back your last 20 changes; the history reverts any of them.'],
  ['Views', 'Scan, PvP and Roll ship as views 1, 2 and 3, on <kbd>Alt</kbd>+<kbd>1</kbd> to <kbd>3</kbd>.'],
];

const fightItems: Item[] = [
  ['Kills', 'Killmails from zKillboard, live, on the node and in the Kills widget.'],
  ['Sovereignty', 'Who holds a null-sec system, in the game’s colour of your standing toward them.'],
  ['Local', 'Your tracked pilots in the system, with their ships, yours first.'],
];

const capitalItems: Item[] = [
  ['Every jump hull', 'Jump freighters, black ops, Rorqual, carriers, dreads, lancers, FAX, supers and titans.'],
  ['Fatigue', 'Fatigue and waiting per leg; keep it under a limit you pick.'],
  ['Out', 'Set the waypoints in game, or copy the route for fleet chat.'],
];

const allianceItems: Item[] = [
  ['Shared chains', 'Corps share their maps, read or read-write; an alliance map merges them field by field.'],
  ['Access', 'Rules by character, corporation, alliance, Discord role or account.'],
  ['Discord', 'New connections, EOL, danger, kills and pings, over a webhook or the bot.'],
];

const agentItems: Item[] = [
  ['“Where are we, and what is still open?”', 'Reads the chain, connections most urgent first.'],
  ['“How do I get to Jita from here?”', 'Finds the route over gates and the chain.'],
  ['“What changed while I was docked?”', 'Lists the latest changes, and who made them.'],
];

const wandererItems: Item[] = [
  ['Everything on the map', 'Systems, connections, signatures, structures, comments, labels, tags and access lists.'],
  ['A preview first', 'It says what comes over as it is, what comes over close to it, and what is left out.'],
  ['Keep syncing', 'From Wanderer every 5 to 60 minutes while the corp moves over.'],
];

const hostItems: Item[] = [
  ['Setup', 'Set <code>PUBLIC_URL</code> and an EVE application in <code>.env</code>; that is all it needs.'],
  ['Database', 'SQLite in the volume by default, or Postgres.'],
  ['Size', 'One container holds a whole alliance: 400 people connected.'],
];

// In order. No dates: one thing is finished, then the next is taken.
const roadmap = [
  {
    status: 'done',
    title: 'Everything a Wanderer chain needs',
    text: 'Version 0.1.0: the live map, scanning, kills and sovereignty, routes, the jump planner, sharing between maps, the API and the import from Wanderer.',
  },
  {
    status: 'now',
    title: 'Beta: stability and polish',
    text: 'The hosted instance is open. We fix and polish from what pilots report through <strong>Help, Report a problem</strong> in the app.',
  },
  {
    status: 'next',
    title: '1.0',
    text: 'A stable release, and a published Docker image, so self-hosting starts with a pull instead of a build.',
  },
  {
    status: 'later',
    title: 'Plugins marketplace',
    text: 'Selected community plugins, installable from the app, starting with a few of ours such as Discord notifications.',
  },
  {
    status: 'later',
    title: 'Exploring: maps shared between instances',
    text: 'Sharing a chain with an alliance member on another Darkbeacon. The API already reserves its scopes.',
  },
];

const statusLabel: Record<string, string> = { done: 'Done', now: 'In progress', next: 'Next', later: 'Later' };
---

<Layout title={title} description={description} jsonLd={jsonLd} pillAfterHero>
  <main id="main">
    <!-- ───────────── Hero ───────────── -->
    <section class="hero" id="top" aria-labelledby="hero-title" data-stage-host>
      <Stage scene="beacon" still="/media/beacon" widths={[960, 1920]} mobileStill="/media/beacon-mobile" loop="/media/beacon-loop" class="hero-stage" />
      <div class="hero-veil" aria-hidden="true"></div>
      <div class="hero-inner container">
        <a class="announce" href="#wanderer">
          <span class="announce-tag">New</span>
          <span>Import from Wanderer, intel included</span>
          <Fragment set:html={arrow} />
        </a>
        <h1 id="hero-title" class="hero-title">
          The chain map your whole corp edits live.
          <span>On a server you run.</span>
        </h1>
        <p class="hero-lede">
          Built to replace Wanderer, and it imports from it. Scan, map, fight and plan capital jumps in one app next to
          the client. Every change reaches everyone looking at the map the moment it is made.
        </p>
        <div class="hero-actions" data-pill-hide>
          <a class="btn btn--primary btn--lg" href={APP_URL} data-warp><span class="warp-label">Open app</span><Fragment set:html={arrow} /></a>
          <a class="btn btn--lg" href={SELF_HOST_URL}><Fragment set:html={server} />Self-host</a>
          <a class="btn btn--lg btn--agents" href="/mcp-setup"><AgentAvatars class="agent-avatars--sm" />Set up an AI agent</a>
        </div>
        <p class="hero-beta" id="beta">
          <span class="beta beta--inline">Beta</span>
          <span>Hosted and usable today. We are fixing and polishing from pilots’ reports: <strong>Help, Report a problem</strong> in the app, or <a href={ISSUES_URL}>an issue on GitHub</a>.</span>
        </p>
      </div>
      <div class="hero-facts container">
        <p class="facts-title">One app next to the client</p>
        <dl class="facts">
          <div><dt>Runs as</dt><dd>One Docker container, one port</dd></div>
          <div><dt>Database</dt><dd>SQLite, or Postgres</dd></div>
          <div><dt>Sign-in</dt><dd>EVE Online, or Discord</dd></div>
          <div><dt>Data</dt><dd>ESI, zKillboard, EVE-Scout</dd></div>
        </dl>
      </div>
    </section>

    <!-- ───────────── Transit: into the chain ───────────── -->
    <section class="transit" aria-labelledby="life-title" data-stage-host>
      <Stage scene="transit" mood="enter" still="/media/transit-enter" class="transit-stage" />
      <div class="transit-inner container">
        <p class="eyebrow"><b>K162</b> Built for wormhole life</p>
        <h2 id="life-title" class="transit-title">Scan it. Map it. Fight it.<br /> <span>Move the capitals through it.</span></h2>
        <ol class="steps" aria-label="What Darkbeacon does, in order">
          {
            steps.map((s, i) => (
              <li>
                <a href={`#${s.id}`}>
                  <span class="mono">{s.n}</span>
                  {s.name}
                </a>
                {i < steps.length - 1 && <span class="steps-link" aria-hidden="true" />}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ───────────── 01 Scan ───────────── -->
    <section class="feature feature--scan" id="scan" aria-labelledby="scan-title" data-stage-host>
      <div class="container">
        <div class="scan-grid">
          <div class="feature-copy">
            <p class="eyebrow"><b>01</b> Scan</p>
            <h2 id="scan-title" class="feature-title">Paste the scanner, read the hole.</h2>
            <p class="feature-lede">Press <kbd>Ctrl</kbd>+<kbd>V</kbd> anywhere on the map and the probe scanner’s results land in the selected system.</p>
            <ul class="items">
              {scanItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
            </ul>
            <a class="more-link" href="/features#scan">Scanning in detail<Fragment set:html={arrow} /></a>
          </div>
          <div class="scan-visual">
            <Stage scene="probes" still="/media/probes" widths={[576, 1152]} class="probes-stage" sizes="(min-width: 1024px) 576px, 100vw" />
            <ul class="scan-key" aria-hidden="true">
              <li style="--c: var(--scan-red)">&lt; 25 %</li>
              <li style="--c: var(--scan-orange)">25–75 %</li>
              <li style="--c: var(--scan-yellow)">75–100 %</li>
              <li style="--c: var(--scan-green)">Warpable</li>
            </ul>
            <Frame class="scan-shot" tilt="left">
              <Shot
                name="signatures"
                sizes="(min-width: 1024px) 400px, 80vw"
                alt="The Signatures widget: nine signatures, one unscanned in red, four wormholes in blue-violet with their types, K162 and U210 with lifetime marks, and sites in green."
              />
            </Frame>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────────── 02 Map ───────────── -->
    <section class="feature feature--map" id="map" aria-labelledby="map-title" data-stage-host>
      <div class="container">
        <div class="feature-head feature-head--inline">
          <p class="eyebrow"><b>02</b> Map</p>
          <h2 id="map-title" class="feature-title">Everyone edits the same chain.<br /><span>Nobody waits for a refresh.</span></h2>
          <p class="feature-lede">Every change is streamed to everyone on the map, and to Discord.</p>
        </div>
      </div>
      <Stage scene="chain" still="/media/chain" class="chain-stage">
        <div class="chain-labels">
          {
            chainNodes.map((node, i) => (
              <span class="chain-label" data-node={i}>
                <b>{node.name}</b>
                <small>{node.meta}</small>
              </span>
            ))
          }
        </div>
      </Stage>
      <div class="container">
        <ul class="items items--row">
          {mapItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
        </ul>
        <p class="section-more"><a class="more-link" href="/features#map">The map, its colours and routes<Fragment set:html={arrow} /></a></p>
      </div>
    </section>

    <!-- ───────────── 03 Fight ───────────── -->
    <!-- ───────────── 03 Fight ───────────── -->
    <section class="transit transit--fight" aria-labelledby="fight-title" data-stage-host id="fight">
      <Stage scene="transit" mood="fight" still="/media/transit-fight" class="transit-stage" />
      <div class="transit-inner container">
        <p class="eyebrow"><b>03</b> Fight</p>
        <h2 id="fight-title" class="transit-title">Know who is in the chain<br /><span>before you undock.</span></h2>
      </div>
    </section>
    <section class="feature feature--fight" aria-label="Fight: kills, sovereignty and local">
      <div class="container">
        <figure class="wide-figure">
          <Frame label="View 2 · PvP">
            <Shot
              name="pvp"
              sizes="(min-width: 1248px) 1200px, calc(100vw - 2rem)"
              alt="The PvP view: the chain, and for the home hole System info, Local with two tracked pilots in a Loki and a Sabre, Kills across every system on the map in the last 4 hours, and Comments."
            />
          </Frame>
        </figure>
        <ul class="items items--row" data-reveal>
          {
            fightItems.map(([name, text], i) => (
              <li>
                <h3>
                  {i === 0 && <span class="ring-dot" aria-hidden="true" />}
                  {name}
                </h3>
                <p set:html={text} />
              </li>
            ))
          }
        </ul>
        <p class="section-more"><a class="more-link" href="/features#fight">Kills, activity and structures<Fragment set:html={arrow} /></a></p>
      </div>
    </section>

    <!-- ───────────── 04 Capitals ───────────── -->
    <section class="feature feature--capitals" id="capitals" aria-labelledby="capitals-title" data-stage-host>
      <div class="container">
        <div class="feature-head feature-head--inline">
          <p class="eyebrow"><b>04</b> Move capitals</p>
          <h2 id="capitals-title" class="feature-title">Plan the jumps<br /><span>on a map of known space.</span></h2>
          <p class="feature-lede">A jump planner in the app, with fuel, fatigue and waiting per leg.</p>
        </div>
      </div>
      <Stage scene="jump" still="/media/jump" class="jump-stage">
        <div class="jump-labels">
          <span class="jump-label" data-end="from"><b>Amamake</b><small>Start</small></span>
          <span class="jump-label" data-end="to"><b>1DQ1-A</b><small>8 jumps · 45.97 ly</small></span>
        </div>
      </Stage>
      <div class="container">
        <ul class="items items--row">
          {capitalItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
        </ul>
        <p class="section-more"><a class="more-link" href="/features#capitals">The jump planner in detail<Fragment set:html={arrow} /></a></p>
      </div>
    </section>

    <!-- ───────────── 05 Alliance ───────────── -->
    <section class="feature feature--alliance" id="alliance" aria-labelledby="alliance-title">
      <div class="container">
        <div class="feature-head feature-head--inline" data-reveal>
          <p class="eyebrow"><b>05</b> Run it for your alliance</p>
          <h2 id="alliance-title" class="feature-title">One chain per corp.<br /><span>One map for the alliance.</span></h2>
          <p class="feature-lede">Corps keep their own maps and share them, with the other side’s admin agreeing.</p>
        </div>
        <ul class="items items--row" data-reveal>
          {allianceItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
        </ul>
        <p class="section-more"><a class="more-link" href="/features#alliance">API keys, webhooks, audit and more<Fragment set:html={arrow} /></a></p>
      </div>
    </section>

    <!-- ───────────── AI agents (MCP) ───────────── -->
    <section class="feature feature--agents" id="agents" aria-labelledby="agents-title">
      <div class="container">
        <div class="feature-head feature-head--inline">
          <p class="eyebrow"><b>MCP</b> Ask the map</p>
          <h2 id="agents-title" class="feature-title">Your assistant reads the chain.<br /><span>You keep flying.</span></h2>
          <p class="feature-lede">Claude, VS Code or any other MCP client can work with your map, with exactly the access of the person who approved it.</p>
        </div>
        <ul class="items items--row items--typing" data-reveal>
          {agentItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
        </ul>
        <p class="section-more"><a class="more-link" href="/mcp-setup">Connect Claude, VS Code or Cursor<Fragment set:html={arrow} /></a></p>
      </div>
    </section>

    <!-- ───────────── Wanderer ───────────── -->
    <section class="feature feature--wanderer" id="wanderer" aria-labelledby="wanderer-title">
      <div class="container">
        <div class="wanderer-grid">
          <div class="feature-copy">
            <p class="eyebrow"><b>K162</b> Coming from Wanderer</p>
            <h2 id="wanderer-title" class="feature-title">Bring the chain with you, <span>intel included.</span></h2>
            <p class="feature-lede">Import from wanderer.ltd, your own Wanderer or the file it exports, into a new map or one you use.</p>
            <ul class="items items--check" data-reveal>
              {wandererItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
            </ul>
            <a class="more-link" href="/wanderer">Wanderer and Darkbeacon compared<Fragment set:html={arrow} /></a>
          </div>
          <Frame tilt="right" label="Import from Wanderer">
            <Shot
              name="import"
              sizes="(min-width: 1024px) 560px, calc(100vw - 2rem)"
              alt="Import from Wanderer: choose Wanderer’s API, an export file or Wanderer’s database, then the address, the map and its API key."
            />
          </Frame>
        </div>
      </div>
    </section>

    <!-- ───────────── Self-host ───────────── -->
    <section class="feature feature--host" id="self-host" aria-labelledby="host-title">
      <div class="container">
        <div class="host-grid">
          <div class="feature-copy">
            <p class="eyebrow"><b>HS</b> Self-host</p>
            <h2 id="host-title" class="feature-title">One container.<br /><span>Your data stays on your box.</span></h2>
            <p class="feature-lede">Three commands, one port, and the first account to sign in owns the instance.</p>
            <ul class="items">
              {hostItems.map(([name, text]) => <li><h3>{name}</h3><p set:html={text} /></li>)}
            </ul>
            <a class="more-link" href="/features#self-host">Backups, scaling and metrics<Fragment set:html={arrow} /></a>
          </div>
          <figure class="code code--typing" data-reveal>
            <figcaption>compose.yaml</figcaption>
            <pre><code>{compose.split('\n').map((line, i, all) => <span class="code-line" style={`--line:${i}`}>{line}{i < all.length - 1 ? '\n' : ''}</span>)}</code></pre>
            <figcaption>then</figcaption>
            <pre><code>{install}</code></pre>
          </figure>
        </div>
      </div>
    </section>

    <!-- ───────────── Roadmap ───────────── -->
    <section class="feature feature--roadmap" id="roadmap" aria-labelledby="roadmap-title">
      <div class="container roadmap-grid">
        <div class="feature-head">
          <p class="eyebrow"><b>RM</b> Roadmap</p>
          <h2 id="roadmap-title" class="feature-title">Finished, then next.</h2>
          <p class="feature-lede">One thing at a time, finished before the next, so this is an order, not a calendar.</p>
        </div>
        <ol class="roadmap" aria-label="Roadmap, in order" data-reveal>
          {
            roadmap.map((item) => (
              <li class:list={['roadmap-item', `roadmap-item--${item.status}`]}>
                <span class="roadmap-node" aria-hidden="true" />
                <div>
                  <p class="roadmap-status">{statusLabel[item.status]}</p>
                  <h3>{item.title}</h3>
                  <p set:html={item.text} />
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- ───────────── Source + support ───────────── -->
    <section class="feature feature--open" aria-label="Open source and support">
      <div class="container open-grid">
        <div class="card card--big" id="source">
          <p class="eyebrow"><b>SRC</b> Open source</p>
          <h2 class="feature-title feature-title--sm">Read every line.</h2>
          <p>
            Server, web app, plugin SDK and themes are on GitHub. Plugins add widgets and Discord notifiers; themes restyle
            the map. Bug reports and pull requests are welcome.
          </p>
          {/* TODO: name the licence here once a LICENSE file is in the repository. */}
          <a class="btn" href={REPO_URL}><Fragment set:html={github} />zanreal-labs/darkbeacon</a>
        </div>
        <div class="card card--big" id="support">
          <p class="eyebrow"><b>ISK</b> Support the project</p>
          <h2 class="feature-title feature-title--sm">Built in spare time, for everyone in J-space.</h2>
          <p>
            If it saves your fleet a few jumps, you can send ISK in game. It buys no features and no priority; every
            instance works the same either way.
          </p>
          <a class="btn" href="/sponsor">How to sponsor <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </section>

    <!-- ───────────── Final call ───────────── -->
    <section class="transit transit--exit" aria-labelledby="exit-title" data-stage-host>
      <Stage scene="transit" mood="exit" still="/media/transit-exit" class="transit-stage" />
      <div class="transit-inner container">
        <Logo size={44} class="exit-mark" />
        <h2 id="exit-title" class="transit-title">Light the beacon.</h2>
        <p class="exit-lede">Open the hosted instance, or run your own.</p>
        <div class="hero-actions" data-pill-hide>
          <a class="btn btn--primary btn--lg" href={APP_URL} data-warp><span class="warp-label">Open app</span><Fragment set:html={arrow} /></a>
          <a class="btn btn--lg" href={SELF_HOST_URL}><Fragment set:html={server} />Self-host</a>
          <a class="btn btn--lg btn--agents" href="/mcp-setup"><AgentAvatars class="agent-avatars--sm" />Set up an AI agent</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
