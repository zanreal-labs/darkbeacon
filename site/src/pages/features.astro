---
import Layout from '../layouts/Layout.astro';
import Frame from '../components/Frame.astro';
import Shot from '../components/Shot.astro';
import { arrow } from '../components/icons';
import { APP_URL, SELF_HOST_URL } from '../config';
import { compose, install } from '../data/snippets';

// The details behind each section of the homepage, kept here so the homepage can stay short.
const title = 'Darkbeacon features in detail';
const description =
  'Everything behind the homepage: scanning and wormhole types, the live map and its colours, kill intel, the capital jump planner, alliance sharing, the API and self-hosting.';

const sections = [
  { id: 'scan', name: 'Scan' },
  { id: 'map', name: 'Map' },
  { id: 'colours', name: 'Colours' },
  { id: 'fight', name: 'Fight' },
  { id: 'capitals', name: 'Capitals' },
  { id: 'alliance', name: 'Alliance' },
  { id: 'self-host', name: 'Self-host' },
];

// Numbered marks on the chain screenshot (fractions of the image), described in the legend.
const marks = [
  { n: 1, x: 47.8, y: 37.3, text: 'Home. Class pill, statics with where they lead (D845 HS, U210 LS), the effect as a dot.' },
  { n: 2, x: 41.6, y: 45.6, text: 'End of life. Time is the outer colour of a connection: purple at EOL, pink under an hour.' },
  { n: 3, x: 28.6, y: 33.4, text: 'Critical mass, flagged dangerous. Mass is the core colour, danger a red halo.' },
  { n: 4, x: 54.2, y: 48.8, text: 'Reduced mass: an amber core on a neutral line.' },
  { n: 5, x: 22.6, y: 43.4, text: 'Frigate hole. Size is a letter on the line, never its width.' },
  { n: 6, x: 9.4, y: 48.2, text: 'Bubbled on the EC-P8R side.' },
  { n: 7, x: 56.2, y: 36.6, text: 'Exits name the nearest trade hub and the jumps to it.' },
  { n: 8, x: 73.2, y: 31.2, text: 'Signatures in the probe scanner’s colours; identified wormholes in their own blue.' },
  { n: 9, x: 73.2, y: 75.6, text: 'Routes to every trade hub, one square per system in its security colour.' },
  { n: 10, x: 79.4, y: 7.6, text: 'Who is on the map, then views 1, 2, 3: Scan, PvP, Roll. Alt+1 to Alt+3.' },
];

// Each label in whichever of black or white reads better on its colour (only 0.1 needs white).
const security = ['1.0', '0.9', '0.8', '0.7', '0.6', '0.5', '0.4', '0.3', '0.2', '0.1', '0.0'].map((label, i) => [
  label,
  `var(--sec-${String(10 - i).padStart(2, '0')})`,
  label === '0.1' ? '#fff' : '#000',
]);

const copiedRoute = `Thanatos: Amamake > 1DQ1-A (8 jumps, 45.97 ly, 82,754 oxygen isotopes)
1. Jump 5.41 ly to Fasse (0.4, Sinq Laison), cyno, 9,744 fuel
2. Jump 5.14 ly to Ahbazon (0.4, Genesis), cyno, 9,259 fuel
3. Jump 6.80 ly to Noranim (0.3, Genesis), cyno, 12,249 fuel
…
8. Jump 6.09 ly to 1DQ1-A (-0.4, Delve), cyno, 10,971 fuel
Fatigue at the end: 5 h`;

const alliance = [
  ['Shared chains', 'Corps keep their own maps and share them, read or read-write, with the other side’s admin agreeing. An alliance map merges the shared chains field by field and shows where each system came from.'],
  ['Access', 'Rules by character, corporation, alliance, Discord role or account. One account holds every character of a pilot. Roles are checked again every minute.'],
  ['Discord', 'New connections, EOL, danger, kills in the chain, pings, the way home and arrivals, over a webhook or the bot, with role mentions and quiet hours.'],
  ['API keys', 'Personal tokens and service keys, scoped per resource and action, on one map or all, with expiry, IP allow-list, rate limit and a read-only switch.'],
  ['OpenAPI and MCP', 'REST under <code>/api/v1</code>, described at <code>/api/openapi.json</code>. An MCP endpoint at <code>/mcp</code> lets an assistant read the chain and find the way out; off until an admin turns it on.'],
  ['Public maps and webhooks', 'A read-only live view at <code>/p/&lt;token&gt;</code> that shows only what you choose. Webhooks signed with HMAC, each delivery logged.'],
  ['Audit', 'Every change with who, which character and from where, kept in a hash-chained log with an integrity check.'],
  ['Support hub', 'Report a problem from the help menu. A ticket belongs to the EVE character you pick and lists every detail it sends before you send it.'],
];
---

<Layout title={title} description={description}>
  <main id="main" class="detail">
    <header class="page-head container">
      <p class="eyebrow"><b>DB</b> Features</p>
      <h1 class="page-title">Every detail, <span>in one place.</span></h1>
      <p class="page-lede">The homepage keeps it short. This is the full list, section by section.</p>
      <nav class="page-toc" aria-label="On this page">
        {sections.map((s) => <a href={`#${s.id}`}>{s.name}</a>)}
      </nav>
    </header>

    <section class="detail-section container" id="scan" aria-labelledby="scan-title">
      <div class="detail-head">
        <p class="eyebrow"><b>01</b> Scan</p>
        <h2 id="scan-title" class="feature-title feature-title--sm">Paste the scanner, read the hole.</h2>
        <p class="feature-lede">
          Copy the probe scanner, press <kbd>Ctrl</kbd>+<kbd>V</kbd> anywhere on the map, and the results land in the
          selected system. A toast says what changed, “3 new / 1 updated”. A paste never downgrades a signature someone
          already scanned further.
        </p>
      </div>
      <div class="detail-grid">
            <dl class="specs">
              <div><dt>Scan colours</dt><dd>As the client draws them: red under 25 %, orange to 75 %, yellow to 100 %, green when you can warp.</dd></div>
              <div><dt>Wormholes</dt><dd>Identified holes in their own blue-violet, with a bar on the row.</dd></div>
              <div><dt>Leads to</dt><dd>Link a signature to its connection; the bookmark code shows above the system.</dd></div>
              <div><dt>Expiry</dt><dd>Signatures go 24 h after they were added (a switch per map). Untouched ones also go after 14 days, or what the map sets.</dd></div>
            </dl>
            <Frame tilt="left">
              <Shot
                name="signatures"
                sizes="(min-width: 1024px) 400px, 80vw"
                alt="The Signatures widget: nine signatures, one unscanned in red, four wormholes in blue-violet with their types, K162 and U210 with lifetime marks, and sites in green."
              />
            </Frame>
      </div>
        <figure class="wide-figure">
          <Frame label="Wormhole types">
            <Shot
              name="wormholes"
              sizes="(min-width: 1248px) 1200px, calc(100vw - 2rem)"
              alt="The Wormhole types dialog: 102 types with where they spawn, lifetime, total mass, mass per jump, size and respawn."
            />
          </Frame>
          <figcaption>
            <strong>Wormhole types.</strong> All 102, K162 included: where they spawn, lifetime, total and per-jump mass, the
            biggest hull that fits, static or wandering. Press <kbd>W</kbd>, or click any type code on the map.
          </figcaption>
        </figure>
    </section>

    <section class="detail-section container" id="map" aria-labelledby="map-title">
      <div class="detail-head">
        <p class="eyebrow"><b>02</b> Map</p>
        <h2 id="map-title" class="feature-title feature-title--sm">Everyone edits the same chain.</h2>
      </div>
        <div class="map-specs">
          <dl class="specs">
            <div><dt>Live</dt><dd>Every change is streamed to everyone on the map, and to Discord.</dd></div>
            <div><dt>Cursors</dt><dd>Another pilot’s cursor shows only while they move, link, edit or paste, with their name and what they are doing. 2.5 s later it fades. Moving the mouse shows nothing.</dd></div>
            <div><dt>Automapping</dt><dd>The server reads tracked characters from ESI every 5 s. A jump adds the system and the connection, browser open or not.</dd></div>
            <div><dt>Undo</dt><dd><kbd>Ctrl</kbd>+<kbd>Z</kbd> takes back your last 20 changes. The map’s history lists who changed what, reverts it, exports CSV or JSON.</dd></div>
          </dl>
          <dl class="specs">
            <div><dt>Views</dt><dd>Lay the widgets out per job. Scan, PvP and Roll ship as views 1, 2 and 3; managers publish a view as the map’s default.</dd></div>
            <div><dt>Statics</dt><dd>On the node with where they lead, <code>D845 HS</code>. Effects as a dot: Pulsar, Wolf-Rayet, Magnetar, Black Hole, Red Giant, Cataclysmic Variable.</dd></div>
            <div><dt>Bookmarks</dt><dd>Numbering kept on the server so everyone sees the same codes. Click to copy.</dd></div>
            <div><dt>Keys</dt><dd><kbd>F</kbd> fit chain, <kbd>C</kbd> centre on me, <kbd>L</kbd> legend, <kbd>W</kbd> wormhole types.</dd></div>
          </dl>
        </div>

        <figure class="annotated">
          <Frame label="Darkbeacon · Demo chain" class="annotated-frame">
            <div class="annotated-scroll" tabindex="0" role="region" aria-label="Annotated screenshot, scrolls sideways on small screens">
              <div class="annotated-image">
                <Shot
                  name="chain"
                  sizes="(min-width: 1248px) 1200px, calc(100vw - 2rem)"
                  alt="The demo chain in Darkbeacon: a C3 home hole linked to a C2, a C5 Pulsar flagged hostile, a null-sec system, a high-sec exit and a low-sec exit. On the right, the System info, Signatures and Routes widgets for the home system."
                />
                {
                  marks.map((m) => (
                    <span class="pin" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">
                      {m.n}
                    </span>
                  ))
                }
              </div>
            </div>
          </Frame>
          <figcaption>
            <p class="swipe">The screenshot scrolls sideways.</p>
            <ol class="legend">
              {
                marks.map((m) => (
                  <li>
                    <span class="legend-n" aria-hidden="true">{m.n}</span>
                    <span>{m.text}</span>
                  </li>
                ))
              }
            </ol>
          </figcaption>
        </figure>
    </section>

    <section class="detail-section container" id="colours" aria-labelledby="colours-title">
      <div class="detail-head">
        <p class="eyebrow"><b>02</b> Colours and routes</p>
        <h2 id="colours-title" class="feature-title feature-title--sm">Colours mean what they mean in game.</h2>
      </div>
        <div class="map-detail">
          <div class="card legend-card">
            <h3>Colours mean what they mean in game</h3>
            <p class="card-note">Security, exactly as the client draws it:</p>
            <ol class="sec-scale">
              {security.map(([label, color, ink]) => <li style={`--c:${color};--ink:${ink}`}><span class="mono">{label}</span></li>)}
            </ol>
            <p class="card-note">Standings toward who holds the space, as the client tags them:</p>
            <ul class="standings">
              <li style="--c: var(--standing-excellent)">+10</li>
              <li style="--c: var(--standing-good)">+5</li>
              <li style="--c: var(--standing-bad)">−5</li>
              <li style="--c: var(--standing-terrible)">−10</li>
            </ul>
            <p class="card-note">One line per connection, read by colour:</p>
            <ul class="edges">
              <li><span class="edge" style="--outer: var(--edge); --core: var(--edge)"></span>Fresh</li>
              <li><span class="edge" style="--outer: var(--edge-eol); --core: var(--edge)"></span>End of life</li>
              <li><span class="edge" style="--outer: var(--edge-time-critical); --core: var(--edge)"></span>Under an hour</li>
              <li><span class="edge" style="--outer: var(--edge); --core: var(--edge-reduced)"></span>Reduced mass</li>
              <li><span class="edge" style="--outer: var(--edge); --core: var(--edge-critical)"></span>Critical mass</li>
              <li><span class="edge edge--danger" style="--outer: var(--edge); --core: var(--edge)"></span>Dangerous</li>
              <li><span class="edge edge--bubble" style="--outer: var(--edge); --core: var(--edge)"></span>Bubbled</li>
              <li><span class="edge edge--size" style="--outer: var(--edge); --core: var(--edge)"><b>S</b></span>Frigate size</li>
            </ul>
          </div>
          <div class="card routes-card">
            <Frame tilt="right">
              <Shot
                name="routes"
                sizes="(min-width: 1024px) 400px, 90vw"
                alt="The Routes widget: Jita and Rens 4 jumps, Dodixie 8, Amarr and Hek 9, each route drawn as squares in the security colour of every system on it."
              />
            </Frame>
            <h3>Routes from the chain</h3>
            <p>
              Jita, Amarr, Dodixie, Rens and Hek on every map, up to 20 hubs, your own on top. Thera and Turnur holes come
              from EVE-Scout every five minutes. Shortest, safer, high-sec only or outlaw; skip EOL, critical, frigate or
              bubbled holes. Set the destination in game for any character whose grant allows it.
            </p>
          </div>
          <figure class="card dialog-card">
            <Frame tilt="left">
              <Shot
                name="edit-system"
                sizes="(min-width: 1024px) 360px, 80vw"
                alt="The Edit system dialog for J014348: custom and temporary names, status Home, Labels WH1 to WH3, a preview of the chips above the node, Tags, Markdown notes and the position lock."
              />
            </Frame>
            <figcaption><strong>Edit system.</strong> Double-click a node. Every change saves as you make it.</figcaption>
          </figure>
        </div>
    </section>

    <section class="detail-section container" id="fight" aria-labelledby="fight-title">
      <div class="detail-head">
        <p class="eyebrow"><b>03</b> Fight</p>
        <h2 id="fight-title" class="feature-title feature-title--sm">Know who is in the chain before you undock.</h2>
      </div>
        <div class="fight-grid">
          <dl class="specs">
            <div><dt>Kills</dt><dd>Killmails from zKillboard, live, on the node and in the Kills widget: this system or the whole map, the last 4, 12 or 24 hours. A new kill rings the node once.</dd></div>
            <div><dt>Activity</dt><dd>Kills, NPC kills and jumps for the last hour and day from ESI, the busiest hours, and who kills there most over 7 days.</dd></div>
            <div><dt>Sovereignty</dt><dd>Who holds a null-sec system, as a ticker under the node, in the game’s colour of your standing toward them.</dd></div>
          </dl>
          <dl class="specs">
            <div><dt>Local</dt><dd>Your tracked pilots in the system, with their ships, yours first.</dd></div>
            <div><dt>Structures</dt><dd>Paste them from the client: type, owner, status and timer.</dd></div>
            <div><dt>Comments</dt><dd>A thread per system. “Rolling the D845 after downtime.”</dd></div>
          </dl>
        </div>
        <figure class="wide-figure">
          <Frame label="View 2 · PvP">
            <Shot
              name="pvp"
              sizes="(min-width: 1248px) 1200px, calc(100vw - 2rem)"
              alt="The PvP view: the chain, and for the home hole System info, Local with two tracked pilots in a Loki and a Sabre, Kills across every system on the map in the last 4 hours, and Comments."
            />
          </Frame>
          <figcaption>
            <strong>The PvP view</strong>, one keypress away: <kbd>Alt</kbd>+<kbd>2</kbd>. Kills here are set to every system
            on the map.
          </figcaption>
        </figure>
    </section>

    <section class="detail-section container" id="capitals" aria-labelledby="capitals-title">
      <div class="detail-head">
        <p class="eyebrow"><b>04</b> Move capitals</p>
        <h2 id="capitals-title" class="feature-title feature-title--sm">Plan the jumps on a map of known space.</h2>
      </div>
        <figure class="wide-figure">
          <Frame label="Jump planner">
            <Shot
              name="jump"
              sizes="(min-width: 1248px) 1200px, calc(100vw - 2rem)"
              alt="The jump planner: a Thanatos from Amamake to 1DQ1-A, 8 jumps and 45.97 light years drawn over a top-down map of known space in security colours, with fuel, fatigue and waiting per leg."
            />
          </Frame>
        </figure>
        <div class="capitals-grid">
          <dl class="specs">
            <div><dt>Hulls</dt><dd>Jump freighters, black ops, Rorqual, carriers, dreads, lancers, FAX, supers and titans.</dd></div>
            <div><dt>Skills</dt><dd>Jump Drive Calibration, Jump Fuel Conservation and Jump Freighters set range and fuel.</dd></div>
            <div><dt>Fatigue</dt><dd>Fatigue and waiting per leg; keep it under a limit you pick.</dd></div>
            <div><dt>Options</dt><dd>Finish over stargates, stop at NPC stations, outlaw, avoid systems, Ansiblex bridges.</dd></div>
            <div><dt>Out</dt><dd>Set the waypoints in game, or copy the route for fleet chat.</dd></div>
          </dl>
          <figure class="code">
            <figcaption>Copy route</figcaption>
            <pre><code>{copiedRoute}</code></pre>
          </figure>
        </div>
    </section>

    <section class="detail-section container" id="alliance" aria-labelledby="alliance-title">
      <div class="detail-head">
        <p class="eyebrow"><b>05</b> Run it for your alliance</p>
        <h2 id="alliance-title" class="feature-title feature-title--sm">One chain per corp. One map for the alliance.</h2>
      </div>
        <ul class="cards">
          {
            alliance.map(([name, text]) => (
              <li class="card">
                <h3>{name}</h3>
                <p set:html={text} />
              </li>
            ))
          }
        </ul>
      <p class="section-more"><a class="more-link" href="/mcp-setup">Set up an AI agent over MCP<Fragment set:html={arrow} /></a></p>
    </section>

    <section class="detail-section container" id="self-host" aria-labelledby="host-title">
      <div class="detail-head">
        <p class="eyebrow"><b>HS</b> Self-host</p>
        <h2 id="host-title" class="feature-title feature-title--sm">One container. Your data stays on your box.</h2>
      </div>
      <div class="host-grid">
        <figure class="code">
          <figcaption>compose.yaml</figcaption>
          <pre><code>{compose}</code></pre>
          <figcaption>then</figcaption>
          <pre><code>{install}</code></pre>
        </figure>
          <dl class="specs specs--grid">
            <div><dt>Setup</dt><dd>Set <code>PUBLIC_URL</code> and an EVE application in <code>.env</code>; that is all it needs. The first account to sign in owns the instance.</dd></div>
            <div><dt>Volume</dt><dd><code>/data</code> holds the SQLite database, backups and the secret key.</dd></div>
            <div><dt>Database</dt><dd>SQLite in the volume by default; set <code>DATABASE_URL</code> for Postgres.</dd></div>
            <div><dt>Scale out</dt><dd>On Postgres, <code>CLUSTER=postgres</code> runs several replicas: one leads by advisory lock, events cross over NOTIFY.</dd></div>
            <div><dt>Backups</dt><dd>On SQLite, daily by default, the 14 newest kept. Restore from Admin, Backups, or the command line.</dd></div>
            <div><dt>Size</dt><dd>One container holds a whole alliance: thousands of accounts, 600 characters tracked online, 400 people connected.</dd></div>
            <div><dt>Metrics</dt><dd>OpenTelemetry traces, metrics and logs once an OTLP endpoint is set; Prometheus at <code>/metrics</code>.</dd></div>
            <div><dt>Telemetry</dt><dd>Anonymous usage counts from production builds, never names or systems. <code>TELEMETRY=off</code> stops it.</dd></div>
            <div><dt>App</dt><dd>Installs from the browser and runs in its own window next to the client.</dd></div>
          </dl>
      </div>
    </section>

    <div class="container detail-cta">
      <a class="btn btn--primary btn--lg" href={APP_URL} data-warp><span class="warp-label">Open app</span><Fragment set:html={arrow} /></a>
      <a class="btn btn--lg" href={SELF_HOST_URL}>Self-host guide</a>
      <a class="btn btn--lg btn--ghost" href="/">Back to the homepage</a>
    </div>
  </main>
</Layout>
