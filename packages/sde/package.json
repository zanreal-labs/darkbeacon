{
  "name": "@darkbeacon/sde",
  "version": "0.0.0",
  "private": true,
  "description": "Builds static universe data from the EVE Static Data Export",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "data": "tsc -b && node dist/cli.js",
    "universe": "tsc -b && node dist/cli.js"
  }
}
