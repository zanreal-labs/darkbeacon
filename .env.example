# Public origin of this instance (OAuth redirects are built from it).
PUBLIC_URL=http://localhost:3000

# Root secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Leave empty to let the server generate one and keep it in DATA_DIR/secret.key.
SECRET_KEY=

# Discord application (OAuth2 redirect: <PUBLIC_URL>/api/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# EVE developer application (callback: <PUBLIC_URL>/api/auth/eve/callback).
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Optional Postgres; SQLite at DATA_DIR/app.db when empty.
DATABASE_URL=

PORT=3000
DATA_DIR=/data

# Demo mode for local previews without Discord/EVE: every visitor is signed in as a shared demo
# account and a demo map is seeded. Refused with NODE_ENV=production unless ALLOW_DEMO_MODE=true.
# (DEV_LOGIN / ALLOW_DEV_LOGIN still work as deprecated aliases.)
DEMO_MODE=false

# Anonymous usage statistics to the Darkbeacon maintainers (docs/telemetry.md). On in production builds
# that carry a project key; TELEMETRY=off or DO_NOT_TRACK=1 turns it off (so does Admin > Instance).
TELEMETRY=
DO_NOT_TRACK=
# Only to point telemetry at your own PostHog project; the build's defaults otherwise.
TELEMETRY_POSTHOG_KEY=
TELEMETRY_POSTHOG_HOST=
# Support (docs/support.md). The help menu's "Report a problem" and "Send feedback" open the
# maintainers' support hub; `off` hides them, another https address picks another hub.
SUPPORT_HUB_URL=
# Running a support hub yourself (the maintainers' instance does): see docs/support.md.
# SUPPORT_HUB=on
# SUPPORT_BACKEND=posthog
# Observability (docs/observability.md). An OTLP endpoint turns on traces, metrics and logs, e.g.
# http://collector:4318 or Grafana Cloud's OTLP gateway (with OTEL_EXPORTER_OTLP_HEADERS).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance-id:token>
# OTEL_SERVICE_NAME=darkbeacon
# Prometheus scrape at /metrics, only with `Authorization: Bearer <METRICS_TOKEN>`.
METRICS_PROMETHEUS=false
METRICS_TOKEN=
# SQLite backups (docs/backups.md). Defaults for Admin > Backups, which can change them.
# Where backups go (default DATA_DIR/backups); how often (off, hourly, 6h, 12h, daily, weekly);
# how many automatic ones to keep; optionally remove automatic ones after N days.
BACKUP_DIR=
BACKUP_SCHEDULE=daily
BACKUP_RETENTION=14
BACKUP_MAX_AGE_DAYS=
# Largest file an upload restore accepts, in MB.
BACKUP_MAX_UPLOAD_MB=1024
# Optional alert webhook (a Discord channel webhook or any JSON endpoint) for failed backups and restores.
BACKUP_NOTIFY_URL=
# Several replicas behind one load balancer, sharing DATABASE_URL (Postgres) and DATA_DIR:
# CLUSTER=postgres. See docs/scaling.md.
CLUSTER=none
# Requests a minute from one client address, signed in or not (0: no limit). The server's own
# page renderer on loopback is not counted.
RATE_LIMIT_PER_ADDRESS=600
