# Public origin of this instance (OAuth redirects are built from it).
PUBLIC_URL=http://localhost:3000

# Root secret, at least 32 characters (e.g. `openssl rand -base64 48`).
# Leave empty to let the server generate one and keep it in DATA_DIR/secret.key.
SECRET_KEY=

# Discord application (OAuth2 redirect: <PUBLIC_URL>/api/auth/discord/callback).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# EVE developer application (callback: <PUBLIC_URL>/api/auth/eve/callback).
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Optional Postgres; SQLite at DATA_DIR/app.db when empty.
DATABASE_URL=

PORT=3000
DATA_DIR=/data

# Demo mode for local previews without Discord/EVE: every visitor is signed in as a shared demo
# account and a demo map is seeded. Refused with NODE_ENV=production unless ALLOW_DEMO_MODE=true.
# (DEV_LOGIN / ALLOW_DEV_LOGIN still work as deprecated aliases.)
DEMO_MODE=false

# Observability (docs/observability.md). An OTLP endpoint turns on traces, metrics and logs, e.g.
# http://collector:4318 or Grafana Cloud's OTLP gateway (with OTEL_EXPORTER_OTLP_HEADERS).
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance-id:token>
# OTEL_SERVICE_NAME=darkbeacon
# Prometheus scrape at /metrics, only with `Authorization: Bearer <METRICS_TOKEN>`.
METRICS_PROMETHEUS=false
METRICS_TOKEN=
