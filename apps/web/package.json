{
  "name": "@darkbeacon/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js web app: server-rendered shell, live map, widgets, settings, admin tab",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port ${WEB_PORT:-3001}",
    "build": "next build && cp -r public .next/standalone/apps/web/ && cp -r .next/static .next/standalone/apps/web/.next/",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@darkbeacon/plugin-sdk": "workspace:*",
    "@darkbeacon/shared": "workspace:*",
    "@darkbeacon/theme-sdk": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.55.0",
    "msw": "^3.0.3",
    "next": "16.4.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
