{
  "name": "@darkbeacon/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS composition root: REST under /api, WebSocket at /ws, and the front door of the web app",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "tsc -b && concurrently -k -n tsc,node \"tsc -b -w --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\""
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@darkbeacon/access": "workspace:*",
    "@darkbeacon/audit": "workspace:*",
    "@darkbeacon/core": "workspace:*",
    "@darkbeacon/db": "workspace:*",
    "@darkbeacon/identity": "workspace:*",
    "@darkbeacon/mapping": "workspace:*",
    "@darkbeacon/notifications": "workspace:*",
    "@darkbeacon/plugin-sdk": "workspace:*",
    "@darkbeacon/plugins": "workspace:*",
    "@darkbeacon/routing": "workspace:*",
    "@darkbeacon/sde": "workspace:*",
    "@darkbeacon/shared": "workspace:*",
    "@darkbeacon/theme-sdk": "workspace:*",
    "@darkbeacon/telemetry": "workspace:*",
    "@darkbeacon/tracking": "workspace:*",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "posthog-node": "5.55.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
