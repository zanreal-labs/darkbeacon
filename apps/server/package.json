{
  "name": "@darkbeacon/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS composition root: REST under /api, WebSocket at /ws, and the front door of the web app",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps --import ./dist/adapters/observability/preload.js dist/main.js",
    "dev": "tsc -b && concurrently -k -n tsc,node \"tsc -b -w --preserveWatchOutput\" \"node --watch --enable-source-maps --import ./dist/adapters/observability/preload.js dist/main.js\""
  },
  "dependencies": {
    "@darkbeacon/access": "workspace:*",
    "@darkbeacon/api-keys": "workspace:*",
    "@darkbeacon/audit": "workspace:*",
    "@darkbeacon/backups": "workspace:*",
    "@darkbeacon/core": "workspace:*",
    "@darkbeacon/db": "workspace:*",
    "@darkbeacon/identity": "workspace:*",
    "@darkbeacon/importing": "workspace:*",
    "@darkbeacon/intel": "workspace:*",
    "@darkbeacon/jumps": "workspace:*",
    "@darkbeacon/mapping": "workspace:*",
    "@darkbeacon/notifications": "workspace:*",
    "@darkbeacon/oauth": "workspace:*",
    "@darkbeacon/observability": "workspace:*",
    "@darkbeacon/plugin-sdk": "workspace:*",
    "@darkbeacon/plugins": "workspace:*",
    "@darkbeacon/publishing": "workspace:*",
    "@darkbeacon/routing": "workspace:*",
    "@darkbeacon/sde": "workspace:*",
    "@darkbeacon/shared": "workspace:*",
    "@darkbeacon/sharing": "workspace:*",
    "@darkbeacon/support": "workspace:*",
    "@darkbeacon/telemetry": "workspace:*",
    "@darkbeacon/theme-sdk": "workspace:*",
    "@darkbeacon/tracking": "workspace:*",
    "@fastify/busboy": "^3.2.5",
    "@fastify/otel": "1.0.1",
    "@modelcontextprotocol/server": "2.4.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/platform-ws": "^12.4.2",
    "@nestjs/websockets": "^12.4.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-prometheus": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/instrumentation-http": "0.301.1",
    "@opentelemetry/instrumentation-nestjs-core": "0.72.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@scalar/api-reference": "1.78.0",
    "fastify": "^5.12.8",
    "import-in-the-middle": "3.6.0",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "posthog-node": "5.69.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.23",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2"
  }
}
