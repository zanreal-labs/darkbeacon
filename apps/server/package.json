{
  "name": "@darkbeacon/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS composition root: REST under /api, WebSocket at /ws, and the front door of the web app",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node --enable-source-maps --import ./dist/adapters/observability/preload.js dist/main.js",
    "dev": "tsc -b && concurrently -k -n tsc,node \"tsc -b -w --preserveWatchOutput\" \"node --watch --enable-source-maps --import ./dist/adapters/observability/preload.js dist/main.js\""
  },
  "dependencies": {
    "@darkbeacon/access": "workspace:*",
    "@darkbeacon/api-keys": "workspace:*",
    "@darkbeacon/audit": "workspace:*",
    "@darkbeacon/backups": "workspace:*",
    "@darkbeacon/core": "workspace:*",
    "@darkbeacon/db": "workspace:*",
    "@darkbeacon/identity": "workspace:*",
    "@darkbeacon/importing": "workspace:*",
    "@darkbeacon/mapping": "workspace:*",
    "@darkbeacon/notifications": "workspace:*",
    "@darkbeacon/oauth": "workspace:*",
    "@darkbeacon/observability": "workspace:*",
    "@darkbeacon/plugin-sdk": "workspace:*",
    "@darkbeacon/plugins": "workspace:*",
    "@darkbeacon/publishing": "workspace:*",
    "@darkbeacon/routing": "workspace:*",
    "@darkbeacon/sde": "workspace:*",
    "@darkbeacon/shared": "workspace:*",
    "@darkbeacon/sharing": "workspace:*",
    "@darkbeacon/telemetry": "workspace:*",
    "@darkbeacon/theme-sdk": "workspace:*",
    "@darkbeacon/tracking": "workspace:*",
    "@fastify/busboy": "^3.2.0",
    "@fastify/otel": "0.21.2",
    "@modelcontextprotocol/server": "2.1.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-prometheus": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "0.35.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@scalar/api-reference": "1.72.1",
    "fastify": "^5.12.5",
    "import-in-the-middle": "3.5.2",
    "kysely": "^0.29.6",
    "posthog-node": "5.55.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "@types/ws": "^8.18.2"
  }
}
